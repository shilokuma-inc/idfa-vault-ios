    },
    "Lock Now" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐロック"
          }
        }
      }
    },
    "Locks automatically 1 minute after the app moves to the background" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドに移ってから1分後に自動でロックされます"
