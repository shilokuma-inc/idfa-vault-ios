    "Check your connection and iCloud settings, and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe deine Verbindung und deine iCloud-Einstellungen und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba la conexión y los ajustes de iCloud, y vuelve a intentarlo."
