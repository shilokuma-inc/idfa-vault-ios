    },
    "Tap to show all digits" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップで全桁を表示"
          }
        }
      }
    },
    "The IDFA of all your devices will be removed from iCloud. Devices that have sync turned on add theirs again the next time IDFA Vault is opened on them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデバイスのIDFAがiCloudから削除されます。同期をオンにしているデバイスは、次にIDFA Vaultを開いたときに再び追加されます。"
          }
        }
      }
    },
    "This device returned an all-zero IDFA, so there is nothing to show." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスからはすべて0のIDFAが返されたため、表示できる値がありません。"
          }
        }
      }
    },
    "This platform doesn't provide the advertising identifier (IDFA) to apps." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラットフォームでは、アプリは広告識別子（IDFA）を取得できません。"
          }
        }
      }
    },
    "Tracking" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキング"
          }
        }
      }
    },
    "Tracking Allowed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキング許可済み"
          }
        }
      }
    },
    "Tracking isn't allowed, so the system returns all zeros. To see your actual IDFA, allow tracking." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングが許可されていないため、システムはすべて0の値を返します。実際のIDFAを確認するには許可が必要です。"
          }
        }
      }
    },
