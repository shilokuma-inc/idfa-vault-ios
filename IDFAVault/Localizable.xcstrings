          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun altro dispositivo. Apri IDFA Vault sugli altri dispositivi collegati allo stesso ID Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ他のデバイスはありません。同じApple IDでサインインしている他のデバイスでIDFA Vaultを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 다른 기기가 없습니다. 같은 Apple ID로 로그인한 다른 기기에서 IDFA Vault를 여십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
