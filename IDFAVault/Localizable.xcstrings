      }
    },
    "Require %@ at Launch" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時に%@を要求"
          }
        }
      }
    },
    "Require Passcode at Launch" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にパスコードを要求"
          }
        }
      }
    },
    "Require Password at Launch" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動時にパスワードを要求"
          }
        }
      }
    },
    "Set a passcode on this device to unlock IDFA Vault." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFA Vaultのロックを解除するには、このデバイスにパスコードを設定してください。"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定"
          }
        }
      }
    },
    "Share" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有"
          }
        }
      }
    },
    "This device returned an all-zero IDFA, so there is nothing to show." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスからはすべて0のIDFAが返されたため、表示できる値がありません。"
          }
        }
      }
    },
    "This platform doesn't provide the advertising identifier (IDFA) to apps." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプラットフォームでは、アプリは広告識別子（IDFA）を取得できません。"
          }
        }
      }
    },
    "Tracking Allowed" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキング許可済み"
          }
        }
      }
    },
    "Tracking isn't allowed, so the system returns all zeros. To see your actual IDFA, allow tracking." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングが許可されていないため、システムはすべて0の値を返します。実際のIDFAを確認するには許可が必要です。"
          }
        }
      }
    },
    "Turn on “IDFA Vault” in the list" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧の「IDFA Vault」をオン"
          }
        }
      }
    },
    "Unlock with %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@でロック解除"
          }
        }
      }
    },
    "Unlock with Passcode" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードでロック解除"
          }
        }
      }
    },
    "Unlock with Password" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードでロック解除"
          }
        }
      }
    },
    "Use Passcode" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスコードを使用"
          }
        }
      }
    },
    "Use Password" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを使用"
          }
        }
      }
    },
    "Verify your identity to show your advertising identifier" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告識別子を表示するには本人確認が必要です"
          }
        }
      }
    },
    "Verify your identity to show your advertising identifier." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告識別子を表示する前に本人確認を行います。"
          }
        }
      }
    },
    "Verifying with Face ID…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDで確認しています…"
          }
        }
      }
    },
    "Verifying with Optic ID…" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optic IDで確認しています…"
          }
        }
      }
    },
    "You can still see the IDFA of your other devices." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のデバイスのIDFAは、このままでも確認できます"
          }
        }
      }
    }
