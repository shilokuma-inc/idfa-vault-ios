        }
      }
    },
    "Locks automatically 5 minutes after the app moves to the background" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドに移ってから5分後に自動でロックされます"
