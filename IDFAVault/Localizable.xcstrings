    "No other devices yet. Open IDFA Vault on your other devices signed in with the same Apple ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine anderen Geräte. Öffne IDFA Vault auf deinen anderen Geräten, die mit derselben Apple-ID angemeldet sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
