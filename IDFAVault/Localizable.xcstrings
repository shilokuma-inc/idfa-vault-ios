    "Allow Tracking" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tracking erlauben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir rastreo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser le suivi"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Pelacakan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti tracciamento"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングを許可"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적 허용"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir Rastreamento"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить отслеживание"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许跟踪"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許追蹤"
          }
        }
      }
    },
    "Allow tracking to show this device's IDFA. It is only shown on screen and never used for advertising." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Tracking, um die IDFA dieses Geräts anzuzeigen. Sie wird nur auf dem Bildschirm angezeigt und nie für Werbung verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el rastreo para mostrar el IDFA de este dispositivo. Solo se muestra en pantalla y nunca se usa para publicidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le suivi pour afficher l’IDFA de cet appareil. Il est uniquement affiché à l’écran et n’est jamais utilisé à des fins publicitaires."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan pelacakan untuk menampilkan IDFA perangkat ini. IDFA hanya ditampilkan di layar dan tidak pernah digunakan untuk iklan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti il tracciamento per mostrare l’IDFA di questo dispositivo. Viene solo mostrato sullo schermo e non viene mai usato per la pubblicità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのIDFAを表示するには、トラッキングを許可してください。画面に表示するだけで、広告には使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적을 허용하면 이 기기의 IDFA를 표시할 수 있습니다. 화면에 표시만 하며 광고에는 절대 사용하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o rastreamento para mostrar o IDFA deste dispositivo. Ele só é mostrado na tela e nunca é usado para publicidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите отслеживание, чтобы показать IDFA этого устройства. Он только показывается на экране и никогда не используется для рекламы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许跟踪后即可显示此设备的 IDFA。它只会显示在屏幕上，绝不会用于广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許追蹤後即可顯示此裝置的 IDFA。它只會顯示在螢幕上，絕不會用於廣告。"
          }
        }
      }
    },
