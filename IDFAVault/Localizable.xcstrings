    "Tracking isn't allowed, so the system returns all zeros. To see your actual IDFA, allow tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Tracking nicht erlaubt ist, gibt das System nur Nullen zurück. Erlaube Tracking, um deine echte IDFA zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como el rastreo no está permitido, el sistema devuelve todo ceros. Para ver tu IDFA real, permite el rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi n’étant pas autorisé, le système renvoie uniquement des zéros. Pour voir votre véritable IDFA, autorisez le suivi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karena pelacakan tidak diizinkan, sistem mengembalikan semua nol. Untuk melihat IDFA Anda yang sebenarnya, izinkan pelacakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché il tracciamento non è consentito, il sistema restituisce solo zeri. Per vedere il tuo IDFA reale, consenti il tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングが許可されていないため、システムはすべて0の値を返します。実際のIDFAを確認するには許可が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추적이 허용되지 않아 시스템이 모두 0인 값을 반환합니다. 실제 IDFA를 확인하려면 추적을 허용하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o rastreamento não é permitido, o sistema retorna apenas zeros. Para ver seu IDFA real, permita o rastreamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поскольку отслеживание не разрешено, система возвращает одни нули. Чтобы увидеть настоящий IDFA, разрешите отслеживание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于未允许跟踪，系统会返回全为 0 的值。要查看实际的 IDFA，请允许跟踪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因未允許追蹤，系統會傳回全為 0 的值。若要查看實際的 IDFA，請允許追蹤。"
          }
        }
      }
    },
