          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Других устройств пока нет. Откройте IDFA Vault на других устройствах, где выполнен вход с тем же Apple ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
