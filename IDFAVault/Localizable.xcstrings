            "state" : "translated",
            "value" : "完了"
          }
        }
      }
    },
    "Each device has its own IDFA, and it changes if you reset it. Synced data is updated automatically the next time each device opens the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFAは端末ごとに異なり、リセットすると値が変わります。同期データは次回起動時に自動で更新されます。"
          }
        }
      }
    },
    "Hidden during screen recording or mirroring" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録・ミラーリング中は表示していません"
