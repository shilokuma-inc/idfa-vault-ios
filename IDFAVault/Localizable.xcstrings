    "Your IDFA is stored only in your iCloud (private database). No one else, including the developer, can see it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine IDFA wird nur in deiner iCloud (private Datenbank) gespeichert. Niemand sonst, auch nicht der Entwickler, kann sie sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu IDFA solo se guarda en tu iCloud (base de datos privada). Nadie más, ni siquiera el desarrollador, puede verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre IDFA est stocké uniquement dans votre iCloud (base de données privée). Personne d’autre, pas même le développeur, ne peut le voir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFA Anda hanya disimpan di iCloud Anda (database pribadi). Tidak ada orang lain, termasuk pengembang, yang dapat melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo IDFA è memorizzato solo nel tuo iCloud (database privato). Nessun altro, nemmeno lo sviluppatore, può vederlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFAはあなたのiCloud（非公開データベース）にのみ保存され、開発者を含む第三者は閲覧できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFA는 사용자의 iCloud(비공개 데이터베이스)에만 저장되며, 개발자를 포함한 누구도 볼 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu IDFA é armazenado apenas no seu iCloud (banco de dados privado). Ninguém mais, nem mesmo o desenvolvedor, pode vê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш IDFA хранится только в вашем iCloud (частная база данных). Никто другой, включая разработчика, не может его увидеть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFA 仅储存在你的 iCloud（私有数据库）中，包括开发者在内的任何人都无法查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFA 只會儲存在你的 iCloud（私人資料庫）中，包括開發者在內的任何人都無法查看。"
          }
        }
      }
    },
