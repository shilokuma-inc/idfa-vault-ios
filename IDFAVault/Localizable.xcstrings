            "value" : "%@"
          }
        }
      }
    },
    "After 1 Minute" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分後"
          }
        }
      }
    },
    "After 5 Minutes" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5分後"
          }
        }
      }
    },
    "Allow Tracking" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラッキングを許可"
          }
        }
      }
    },
    "Allow tracking to show this device's IDFA. It is only shown on screen and never used for advertising." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスのIDFAを表示するには、トラッキングを許可してください。画面に表示するだけで、広告には使いません。"
          }
        }
      }
    },
    "Auto-Lock" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ロック"
          }
        }
      }
    },
    "Back" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻る"
          }
        }
      }
    },
    "Can't be turned off" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにできません"
          }
        }
      }
    },
    "Copied" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーしました"
          }
        }
      }
    },
    "Copied values are cleared from the clipboard after 60 seconds" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーした値は60秒後にクリップボードから消去されます"
          }
        }
      }
    },
    "Copy" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー"
          }
        }
      }
    },
    "Couldn't verify your identity. Try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人確認ができませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "Each device has its own IDFA, and it changes if you reset it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IDFAは端末ごとに異なり、リセットすると値が変わります。"
          }
        }
      }
    },
    "Hidden during screen recording or mirroring" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録・ミラーリング中は表示していません"
          }
        }
      }
    },
    "Hide During Screen Recording or Mirroring" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録・ミラーリング中は隠す"
          }
        }
      }
    },
    "Immediately" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐに"
          }
        }
      }
    },
    "In “Tracking”, turn on “Allow Apps to Request to Track”" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「トラッキング」で「Appからのトラッキング要求を許可」をオン"
