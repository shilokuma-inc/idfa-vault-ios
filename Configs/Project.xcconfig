//
//  Project.xcconfig
//  IDFAVault
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.IDFAVault

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS（iOS と iPadOS・macOS・visionOS の 1 ターゲット）
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MACOSX_DEPLOYMENT_TARGET = 14.0
XROS_DEPLOYMENT_TARGET = 1.0

// macOS の entitlements。iCloud（CloudKit）は provisioning profile が要る entitlement で、profile の無いアドホック署名で付けると
// 起動時にシステムに止められる。CI のテストと archive のアドホック署名は CODE_SIGN_STYLE=Manual にするので、
// 自動の署名（Xcode が profile を用意する）のときだけ iCloud を付ける。配布（TestFlight・App Store）の archive には、
// _archive.yml が archive の後に Tools/embed_archive_entitlements.py で足す。iOS・visionOS は pbxproj で常に付ける
IDFAVAULT_MACOS_ENTITLEMENTS_Automatic = IDFAVault/IDFAVault.entitlements
IDFAVAULT_MACOS_ENTITLEMENTS_Manual =
